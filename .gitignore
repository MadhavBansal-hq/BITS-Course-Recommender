# raw source data — supplied locally, not committed (large + not ours to redistribute)
data/raw/*
!data/raw/.gitkeep
!data/raw/handouts/
data/raw/handouts/*
!data/raw/handouts/.gitkeep

# python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/

# env / secrets
.env
*.key

# OS junk
.DS_Store
Thumbs.db

# editor
.vscode/
.idea/

# build artifacts — regenerated from data/raw/ by src/ingest/*.py, not
# committed (keeps diffs meaningful and avoids re-run noise); run the
# ingest scripts locally after cloning to produce these
data/processed/*
!data/processed/.gitkeep
*.log

# student profiles saved from the dashboard (personal data)
profiles/*
!profiles/.gitkeep
