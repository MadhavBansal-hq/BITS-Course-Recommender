# raw source data — supplied locally, not committed (large + not ours to redistribute)
data/raw/*
!data/raw/.gitkeep
!data/raw/handouts/
data/raw/handouts/*
!data/raw/handouts/.gitkeep

# python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/

# env / secrets
.env
*.key

# OS junk
.DS_Store
Thumbs.db

# editor
.vscode/
.idea/

# build artifacts
data/processed/*.tmp
*.log
